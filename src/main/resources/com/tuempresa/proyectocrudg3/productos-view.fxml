<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.proyectocrudg3.controller.ProductosController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <Label text="Gestión de productos">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <VBox spacing="8.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" text="Código:" />
                        <TextField fx:id="txtCodigo" HBox.hgrow="ALWAYS" />
                        <Label prefWidth="80.0" text="Nombre:" />
                        <TextField fx:id="txtNombre" promptText="Nombre del producto" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" text="Precio:" />
                        <TextField fx:id="txtPrecio" promptText="0.00" HBox.hgrow="ALWAYS" />
                        <Label prefWidth="80.0" text="Stock:" />
                        <TextField fx:id="txtStock" promptText="0" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" text="Categoría:" />
                        <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Label prefWidth="80.0" text="Marca:" />
                        <ComboBox fx:id="cmbMarcaForm" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" text="Fecha:" />
                        <DatePicker fx:id="dpFechaCreacion" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Label prefWidth="80.0" text="Descripción:" />
                        <TextField fx:id="txtDescripcion" promptText="Descripción opcional" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <padding>
                        <Insets top="5.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnNuevo" onAction="#btnNuevoAction" text="Nuevo" />
                        <Button fx:id="btnGuardar" onAction="#btnGuardarAction" text="Guardar" />
                        <Button fx:id="btnActualizar" onAction="#btnActualizarAction" text="Actualizar" />
                        <Button fx:id="btnEliminar" onAction="#btnEliminarAction" text="Eliminar" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Separator prefWidth="200.0" />
        <Label text="Búsqueda y filtros">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <VBox spacing="8.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="120.0" text="Código o nombre:" />
                        <TextField fx:id="txtFiltroBusqueda" promptText="Buscar..." HBox.hgrow="ALWAYS" />
                        <Label prefWidth="90.0" text="Categoría:" />
                        <ComboBox fx:id="cmbFiltroCategoria" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="120.0" text="Desde:" />
                        <DatePicker fx:id="dpFiltroDesde" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Label prefWidth="90.0" text="Hasta:" />
                        <DatePicker fx:id="dpFiltroHasta" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="120.0" text="Precio mínimo:" />
                        <TextField fx:id="txtFiltroPrecioMin" HBox.hgrow="ALWAYS" />
                        <Label prefWidth="90.0" text="Precio máximo:" />
                        <TextField fx:id="txtFiltroPrecioMax" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <CheckBox fx:id="chkSoloConStock" text="Solo productos con existencias" HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Ordenar por:" />
                                <ComboBox fx:id="cmbOrden" prefWidth="180.0" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <padding>
                        <Insets top="5.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnBuscar" onAction="#btnBuscarAction" text="Buscar" />
                        <Button fx:id="btnLimpiarFiltros" onAction="#btnLimpiarFiltrosAction" text="Limpiar filtros" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                <TableColumn fx:id="colMarca" prefWidth="120.0" text="Marca" />
                <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha creación" />
            </columns>
            <placeholder>
                <Label text="Tabla sin contenido" />
            </placeholder>
        </TableView>
    </children>
</VBox>
